<?xml version="1.0" encoding="utf-8"?>
<!--
  The Netvork mark, as a vector.

  Hand-translated from public/icons/icon.svg — the same one the website and the
  web manifest use — because there is no rasteriser on the build machine and an
  icon shipped as PNGs would have to be regenerated at five densities every
  time the brand moves. A VectorDrawable is one file, sharp at any size, and
  the shapes here are simple enough to carry across exactly.

  The three bars of the N are drawn as round-capped strokes rather than
  rounded rectangles: rx equal to half the width makes a stadium, and a
  round-capped line IS a stadium, in a quarter of the path data.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="192dp"
    android:height="192dp"
    android:viewportWidth="340"
    android:viewportHeight="340">

    <path android:pathData="M0,48a48,48 0 0,1 48,-48h244a48,48 0 0,1 48,48v244a48,48 0 0,1 -48,48h-244a48,48 0 0,1 -48,-48z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="340" android:endY="340"
                android:type="linear">
                <item android:offset="0" android:color="#171A8F"/>
                <item android:offset="0.55" android:color="#4022B7"/>
                <item android:offset="1" android:color="#8B35F0"/>
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M58,170a112,112 0 1,0 224,0a112,112 0 1,0 -224,0"
        android:strokeColor="#FFFFFF" android:strokeWidth="7"/>

    <path android:pathData="M156,47a14,14 0 1,0 28,0a14,14 0 1,0 -28,0" android:fillColor="#FFFFFF"/>
    <path android:pathData="M259,92a14,14 0 1,0 28,0a14,14 0 1,0 -28,0" android:fillColor="#FFFFFF"/>
    <path android:pathData="M267,224a14,14 0 1,0 28,0a14,14 0 1,0 -28,0" android:fillColor="#FFFFFF"/>
    <path android:pathData="M59,222a14,14 0 1,0 28,0a14,14 0 1,0 -28,0" android:fillColor="#FFFFFF"/>
    <path android:pathData="M57,92a14,14 0 1,0 28,0a14,14 0 1,0 -28,0" android:fillColor="#FFFFFF"/>

    <path android:pathData="M125,125L125,219" android:strokeColor="#FFFFFF"
        android:strokeWidth="42" android:strokeLineCap="round"/>
    <path android:pathData="M225,125L225,219" android:strokeColor="#FFFFFF"
        android:strokeWidth="42" android:strokeLineCap="round"/>
    <path android:pathData="M125,125L225,220" android:strokeColor="#FFFFFF"
        android:strokeWidth="44" android:strokeLineCap="round"/>
</vector>
