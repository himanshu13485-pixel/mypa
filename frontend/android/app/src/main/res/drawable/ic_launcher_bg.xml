    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="0" android:startY="0" android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#171A8F"/>
                <item android:offset="0.55" android:color="#4022B7"/>
                <item android:offset="1" android:color="#8B35F0"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
