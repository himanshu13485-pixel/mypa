<?xml version="1.0" encoding="utf-8"?>
<!-- The brand gradient, as the adaptive icon's background layer. A flat
     colour lived in values/ic_launcher_background.xml and was white, which is
     why the icon looked like nothing at all next to its own foreground. -->
