# /etc/systemd/system/netvork-reverb.service
[Unit]
Description=Netvork Reverb WebSocket server
After=network.target

[Service]
User=netvork
Group=netvork
Restart=always
RestartSec=3
WorkingDirectory=/home/netvork/mypa/backend
ExecStart=/opt/cpanel/ea-php83/root/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8080
StandardOutput=append:/home/netvork/logs/reverb.log
StandardError=append:/home/netvork/logs/reverb.log

[Install]
WantedBy=multi-user.target
